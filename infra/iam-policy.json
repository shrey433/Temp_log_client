{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2InMumbaiOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstance*",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:*SecurityGroup*",
        "ec2:AuthorizeSecurityGroup*",
        "ec2:RevokeSecurityGroup*",
        "ec2:*Address",
        "ec2:CreateVolume",
        "ec2:DeleteVolume",
        "ec2:ModifyVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "EbsAndSsmEncryptionViaServiceOnly",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "ec2.ap-south-1.amazonaws.com",
            "ssm.ap-south-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectParametersAndPublicAmiLookup",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:ListTagsForResource",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/rtd-logger/*",
        "arn:aws:ssm:ap-south-1::parameter/aws/service/ami-amazon-linux-latest/*"
      ]
    },
    {
      "Sid": "SsmDescribe",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "SessionManagerOnTaggedProjectInstancesOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "rtd-logger"
        }
      }
    },
    {
      "Sid": "SessionManagerShellDocumentAndOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession",
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-1::document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:*:*:session/${aws:username}-*"
      ]
    },
    {
      "Sid": "BundleBucketOnly",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::rtd-logger-bundle-*",
        "arn:aws:s3:::rtd-logger-bundle-*/*"
      ]
    },
    {
      "Sid": "ProjectRolesAndProfilesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/rtd-logger-*",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/rtd-logger-*"
      ]
    },
    {
      "Sid": "AttachOnlyTheTwoManagedPoliciesTheStackUses",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/rtd-logger-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
            "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
          ]
        }
      }
    },
    {
      "Sid": "PassProjectRolesToEc2AndDlmOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/rtd-logger-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "dlm.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DailySnapshotPolicy",
      "Effect": "Allow",
      "Action": [
        "dlm:CreateLifecyclePolicy",
        "dlm:UpdateLifecyclePolicy",
        "dlm:DeleteLifecyclePolicy",
        "dlm:GetLifecyclePolicy",
        "dlm:GetLifecyclePolicies",
        "dlm:TagResource",
        "dlm:UntagResource",
        "dlm:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
